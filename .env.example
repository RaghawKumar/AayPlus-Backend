# Local SQLite development. Do not expose development OTP responses publicly.
APP_ENV=development
HOST=127.0.0.1
PORT=8080
# On Render, include the exact admin origin (for local admin use:
# http://localhost:3000). Add the deployed admin origin when applicable.
CORS_ORIGINS=http://localhost:3000,http://localhost:7357
DATABASE_PATH=./data/aayplus.sqlite3
UPLOAD_DIRECTORY=./data/uploads

# Supabase deployment: all three are required together. With DATABASE_URL set,
# database records and media use Supabase; local paths above are not persistence.
# Supabase > Connect > Session pooler URI (URL-encode the database password).
# Use the connection SSL settings recommended by Supabase, e.g. sslmode=require.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
SUPABASE_LISTING_BUCKET=listing-images
SUPABASE_EVIDENCE_BUCKET=inspection-evidence
# SUPABASE_PUBLISHABLE_KEY and SUPABASE_JWKS_URL are not used by this API.
# Existing AayPlus OTP/session authentication is retained; Supabase Auth is separate.
